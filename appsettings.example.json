{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BlogDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://your-frontend.example.com"
    ]
  },
  "Jwt": {
    "Key": "YOUR_STRONG_SECRET_KEY_AT_LEAST_32_CHARACTERS",
    "Issuer": "BlogApi",
    "Audience": "BlogApiUsers",
    "ExpireHours": 3
  },
  "Firebase": {
    "ProjectId": "your-firebase-project-id"
  },
  "InitialAdmin": {
    "Email": "admin@example.com",
    "Username": "admin",
    "Password": "CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderEmail": "your-email@gmail.com",
    "SenderName": "PulseBlog",
    "Username": "your-email@gmail.com",
    "Password": "your-app-password"
  }
}
